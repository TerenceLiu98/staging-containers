#!/command/with-contenv bash
set -euo pipefail

PERSISTENT_STATE_DIR="${PERSISTENT_STATE_DIR:-${PERSISTENT_DIR}/.state}"
OPENCODE_STATE_DIR="${PERSISTENT_STATE_DIR}/opencode"
CODE_SERVER_STATE_DIR="${PERSISTENT_STATE_DIR}/code-server"
AGENT_CONFIG_DIR="${AGENT_SANDBOX_DIR:-/opt/agent-sandbox}/agent-config"

mkdir -p "${PERSISTENT_DIR}" "${PERSISTENT_STATE_DIR}" "${PERSISTENT_DIR}/Downloads"

if [ ! -e "${PERSISTENT_STATE_DIR}/.home_initialized" ]; then
  echo "INFO: Copying contents of '${HOME_TMP}' to '${HOME}'..."
  cp -r -T --update=none "${HOME_TMP}" "${HOME}"
else
  echo "INFO: Persistent home state already initialized."
fi

link_persistent_dir() {
  local home_path="$1"
  local state_path="$2"

  mkdir -p "$(dirname "${home_path}")" "$(dirname "${state_path}")"

  if [ ! -e "${state_path}" ] && [ ! -L "${state_path}" ]; then
    mkdir -p "${state_path}"
  fi

  if [ -d "${home_path}" ] && [ ! -L "${home_path}" ] && [ -z "$(find "${state_path}" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    cp -a "${home_path}/." "${state_path}/"
  fi

  if [ -e "${home_path}" ] || [ -L "${home_path}" ]; then
    rm -rf "${home_path}"
  fi

  ln -s "${state_path}" "${home_path}"
}

# Copy a bundled default into place only when the user has nothing there yet.
seed_file() {
  local source_path="$1"
  local target_path="$2"

  if [ ! -e "${target_path}" ] && [ ! -L "${target_path}" ]; then
    mkdir -p "$(dirname "${target_path}")"
    cp "${source_path}" "${target_path}"
    chmod 0644 "${target_path}"
  fi
}

seed_dir() {
  local source_path="$1"
  local target_path="$2"

  if [ ! -e "${target_path}" ] && [ ! -L "${target_path}" ]; then
    mkdir -p "$(dirname "${target_path}")"
    cp -r "${source_path}" "${target_path}"
  fi
}

link_persistent_dir "${HOME}/.codex" "${PERSISTENT_STATE_DIR}/codex"
# CLAUDE_CONFIG_DIR points here, so Claude keeps .claude.json inside this directory.
link_persistent_dir "${HOME}/.claude" "${PERSISTENT_STATE_DIR}/claude"
link_persistent_dir "${HOME}/.config/opencode" "${OPENCODE_STATE_DIR}/config"
link_persistent_dir "${HOME}/.local/share/opencode" "${OPENCODE_STATE_DIR}/data"
link_persistent_dir "${HOME}/.cache/opencode" "${OPENCODE_STATE_DIR}/cache"
link_persistent_dir "${HOME}/.local/state/opencode" "${OPENCODE_STATE_DIR}/state"
link_persistent_dir "${HOME}/.zcode" "${PERSISTENT_STATE_DIR}/zcode"
link_persistent_dir "${HOME}/.config/ZCode" "${PERSISTENT_STATE_DIR}/zcode-desktop"
link_persistent_dir "${HOME}/.agent-browser" "${PERSISTENT_STATE_DIR}/agent-browser"
link_persistent_dir "${HOME}/.local/share/code-server/User" "${CODE_SERVER_STATE_DIR}/User"
link_persistent_dir "${HOME}/.local/share/code-server/extensions" "${CODE_SERVER_STATE_DIR}/extensions"
link_persistent_dir "${HOME}/.config/code-server" "${CODE_SERVER_STATE_DIR}/config"
link_persistent_dir "${HOME}/.config/gh" "${PERSISTENT_STATE_DIR}/gh"
# git writes ~/.config/git/config for --global when ~/.gitconfig does not exist.
link_persistent_dir "${HOME}/.config/git" "${PERSISTENT_STATE_DIR}/git"
link_persistent_dir "${HOME}/.config/sandbox-browser" "${PERSISTENT_STATE_DIR}/browser"

touch "${HOME}/.config/git/config"

if [ ! -e "${HOME}/.config/opencode/opencode.json" ]; then
  printf '%s\n' '{' \
    '  "$schema": "https://opencode.ai/config.json",' \
    '  "share": "disabled"' \
    '}' > "${HOME}/.config/opencode/opencode.json"
fi

seed_file "${AGENT_CONFIG_DIR}/AGENTS.md" "${HOME}/.codex/AGENTS.md"
seed_file "${AGENT_CONFIG_DIR}/AGENTS.md" "${HOME}/.claude/CLAUDE.md"
seed_file "${AGENT_CONFIG_DIR}/AGENTS.md" "${HOME}/.config/opencode/AGENTS.md"
seed_dir /opt/agent-browser/skills/agent-browser "${HOME}/.claude/skills/agent-browser"
seed_dir /opt/agent-browser/skills/agent-browser "${HOME}/.codex/skills/agent-browser"

touch "${PERSISTENT_STATE_DIR}/.home_initialized"
