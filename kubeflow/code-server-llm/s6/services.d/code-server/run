#!/command/with-contenv bash

export XDG_RUNTIME_DIR="/tmp/runtime-${NB_USER}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

echo "INFO: Copying contents of '$HOME_TMP' to '$HOME'..."
cp -r -T --update=none "$HOME_TMP" "$HOME"
mkdir -p "${PERSISTENT_DIR}" "${TORCH_HOME}" "${VLLM_CACHE_ROOT}"

if [ "${DISABLE_COPILOT_EXTENSIONS:-true}" = "true" ] && [ -d "${HOME}/.local/share/code-server/extensions" ]; then
  find "${HOME}/.local/share/code-server/extensions" -maxdepth 1 -mindepth 1 \
    \( -iname "github.copilot*" -o -iname "github.copilot-chat*" \) \
    -exec rm -rf {} +
fi

cd "${PERSISTENT_DIR}" || { echo "ERROR: failed to cd to ${PERSISTENT_DIR}"; exit 1; }
echo "INFO: starting code-server..."
exec 2>&1
exec /usr/bin/code-server \
  --bind-addr 0.0.0.0:8888 \
  --disable-telemetry \
  --disable-update-check \
  --disable-workspace-trust \
  --disable-getting-started-override \
  --auth none \
  --trusted-origins "*" \
  "${PERSISTENT_DIR}"
