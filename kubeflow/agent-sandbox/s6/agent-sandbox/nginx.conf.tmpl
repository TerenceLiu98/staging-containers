worker_processes 1;
pid /tmp/nginx/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log off;
    sendfile on;
    server_tokens off;
    client_max_body_size 0;
    absolute_redirect off;

    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $http_x_forwarded_proto $ws_scheme {
        https   wss;
        default ws;
    }

    server {
        listen 8888 default_server;

        # Every app is embedded in the dashboard; all of them share this origin.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;

        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }

        ${PREFIX_REDIRECT}

        location ${PREFIX}/ {
            alias /opt/agent-sandbox/dashboard/;
            index index.html;
            add_header Cache-Control "no-cache";
        }

        location ${PREFIX}/code/ {
            include /etc/agent-sandbox/nginx-proxy.conf;
            proxy_pass http://127.0.0.1:8200/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location ${PREFIX}/vnc/ {
            include /etc/agent-sandbox/nginx-proxy.conf;
            proxy_pass http://127.0.0.1:6080/;
            proxy_set_header Host $host;
        }

        location ${PREFIX}/zcode-vnc/ {
            include /etc/agent-sandbox/nginx-proxy.conf;
            proxy_pass http://127.0.0.1:6081/;
            proxy_set_header Host $host;
        }

        location ${PREFIX}/terminal/ {
            include /etc/agent-sandbox/nginx-proxy.conf;
            proxy_pass http://127.0.0.1:7681;
            proxy_set_header Host $host;
        }

        # Chromium only answers DevTools requests whose Host is localhost or an IP, and it
        # advertises ws://localhost URLs that must be rewritten to this gateway.
        location ${PREFIX}/cdp/ {
            include /etc/agent-sandbox/nginx-proxy.conf;
            proxy_pass http://127.0.0.1:${BROWSER_CDP_PORT}/;
            proxy_set_header Host localhost:${BROWSER_CDP_PORT};
            proxy_set_header Origin "";
            proxy_set_header Accept-Encoding "";
            sub_filter_types application/json;
            sub_filter_once off;
            sub_filter "ws://localhost:${BROWSER_CDP_PORT}/" "$ws_scheme://$http_host${PREFIX}/cdp/";
            sub_filter "localhost:${BROWSER_CDP_PORT}/" "$http_host${PREFIX}/cdp/";
        }
    }
}
